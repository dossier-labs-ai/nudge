{
  "hosting": {
    "site": "nudge-dossierlabs",
    "public": "site",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/README.md"],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  }
}
